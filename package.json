{
  "name": "hotel-mess-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @annapurna/api\" \"npm run dev -w @annapurna/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w @annapurna/api",
    "format": "prettier --write .",
    "docs:api": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.12",
    "esbuild": "^0.25.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tinypool": "^2.1.2"
  }
}
